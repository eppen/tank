# Python 字节码缓存
__pycache__/
*.py[cod]

# 游戏运行时写出的本地文件（删除后都会自动重建默认值）
tank_keys.json

# 对战评估历史（每局一行，最多保留最近 20 局）
tank_coach.json

# 生涯战绩（1P/2P 胜负累计 + 最近对局）
tank_career.json

# 运行日志（TANK_LOG=1 时写在脚本同目录，默认关闭）
tank_run_*.log

# PyInstaller / MSIX 产物
build/
dist/
*.spec.bak

# 系统 / 编辑器杂项
.DS_Store
.vscode/
.idea/
